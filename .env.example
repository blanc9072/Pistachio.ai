# Stock chat brain (default) — served on location=global (auto-selected)
CHAT_MODEL=gemini-3.6-flash
CHAT_TEMPERATURE=1.0
# Fallback — fine-tuned 2.5 endpoint (auto-selects us-west1, no thinking override):
# CHAT_MODEL=projects/andrewgpt-490605/locations/us-west1/endpoints/9200944198671400960
# CHAT_TEMPERATURE=1.5
# Optional hard region override (normally leave unset — location is derived):
# CHAT_MODEL_LOCATION=

# Calendar execution (macOS Calendar via AppleScript) is gated per-user by
# profiles.calendar_enabled, controlled from the Agency Permissions toggle
# in Settings — nothing to set here.

# Calendar I/O provider — "eventkit" (default) or "google". Read by
# core/calendar_backend.py (the ONE seam api/routes.py calls through for
# all calendar reads AND writes) at process start. Flipping this is a
# reversible config toggle, not a migration — restart to apply, restart
# again with the other value to revert.
# CALENDAR_BACKEND=eventkit

# Google write target — which Google calendar new events are created on
# when CALENDAR_BACKEND=google. Default "primary" = the user's main
# calendar. Point this at a throwaway test calendar's id while running the
# Google verify suite so verification never touches the real primary.
# GOOGLE_WRITE_CALENDAR_ID=primary

# Google Calendar OAuth client (G1/G2a) — Desktop app type, from
# console.cloud.google.com/apis/credentials, project andrewgpt-490605.
# Used by core/calendar_google.py to refresh a user's stored token
# (core.db.fetch_google_refresh_token) — NOT per-user, one app client for
# everyone, same pattern as the ElevenLabs/Gemini keys above.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth redirect URI (G3 — in-app Connect Google Calendar flow) — must
# EXACTLY match an Authorized redirect URI on the OAuth client in the
# Google console. Local/desktop: the backend's own callback route.
# Cloud later: a hosted https URI (+ switch the client to "Web
# application") — the code path is identical, only this value changes.
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback

# Phase 2 — cloud deploy to a VPS behind a TLS reverse proxy (Caddy). On the
# box, both listeners bind LOOPBACK-ONLY — Caddy is the one public listener
# (443/80) and reverse-proxies in; 8000/8765 are never reachable from
# outside. Locally, leave all of these unset (API_HOST already defaults to
# 0.0.0.0, fine for a single dev machine with nothing in front of it).
#   API_HOST=127.0.0.1
#   API_PORT=8000
#   WS_HOST=127.0.0.1
#   WS_PORT=8765
# Vertex SA key path — main.py sets GOOGLE_APPLICATION_CREDENTIALS from
# this (falling back to the repo-local "google-key.json" for local dev).
# On the box this points at the actual secret file (see the deploy
# runbook — NOT committed, copied onto the box directly):
#   VERTEX_KEY_PATH=/etc/pistachio/google-key.json
# Once cloud-deployed, GOOGLE_OAUTH_REDIRECT_URI above becomes
# https://<DOMAIN>/oauth/google/callback, against a separate "Web
# application" OAuth client (the desktop-client loopback trick doesn't
# apply to a hosted redirect) — your existing stored refresh token keeps
# working either way; only a fresh Connect flow uses the new client.
